@page "/admin/users"
@rendermode InteractiveServer
@using CampRide.Data.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject UserManager<ApplicationUser> UserMgr
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<h2 class="mb-4">Felhasználók kezelése</h2>

@if (users == null)
{
    <p><em>Betöltés...</em></p>
}
else
{
    <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
        <span class="text-muted">Összesen: <strong>@users.Count</strong> felhasználó</span>
        <input class="form-control w-auto" placeholder="🔍 Keresés email alapján..."
               @bind="searchTerm" @bind:event="oninput" />
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Email</th>
                    <th>Szerepkör</th>
                    <th>Email megerősítve</th>
                    <th>Műveletek</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in FilteredUsers)
                {
                    var isCurrentUser = u.Id == currentUserId;
                    <tr class="@(isCurrentUser ? "table-secondary" : "")">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar">@(u.Email?[0].ToString().ToUpper())</div>
                                <div>
                                    <div class="fw-semibold">@u.Email</div>
                                    @if (isCurrentUser)
                                    {
                                        <small class="text-muted">(te)</small>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            @foreach (var role in userRoles.GetValueOrDefault(u.Id, new List<string>()))
                            {
                                <span class="badge @(role == "Admin" ? "bg-danger" : "bg-primary") me-1">@role</span>
                            }
                        </td>
                        <td>
                            @if (u.EmailConfirmed)
                            {
                                <span class="text-success">✔ Igen</span>
                            }
                            else
                            {
                                <span class="text-muted">– Nem</span>
                            }
                        </td>
                        <td>
                            @if (!isCurrentUser)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (userRoles.GetValueOrDefault(u.Id)?.Contains("Admin") == true)
                                    {
                                        <button class="btn btn-sm btn-outline-warning"
                                                @onclick="() => RemoveAdmin(u.Id)"
                                                title="Admin jog elvétele">
                                            ↓ Admin elvétel
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success"
                                                @onclick="() => MakeAdmin(u.Id)"
                                                title="Admin jogok adása">
                                            ↑ Admin
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ConfirmDelete(u.Id, u.Email!)"
                                            title="Felhasználó törlése">
                                        🗑 Törlés
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">–</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Törlés megerősítő dialog *@
@if (deleteTargetId != null)
{
    <div class="modal-backdrop-custom" @onclick="CancelDelete">
        <div class="confirm-dialog" @onclick:stopPropagation="true">
            <h5>Felhasználó törlése</h5>
            <p>Biztosan törlöd ezt a felhasználót?</p>
            <p><strong>@deleteTargetEmail</strong></p>
            <p class="text-danger small">Ez a művelet visszafordíthatatlan!</p>
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="btn btn-secondary btn-sm" @onclick="CancelDelete">Mégse</button>
                <button class="btn btn-danger btn-sm" @onclick="DeleteUser">Törlés megerősítése</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(messageSuccess ? "alert-success" : "alert-danger") mt-3 alert-dismissible">
        @message
        <button type="button" class="btn-close" @onclick="() => message = null"></button>
    </div>
}

<style>
    .user-avatar {
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        background: linear-gradient(135deg, #3a0647, #05276e);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

    .modal-backdrop-custom {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9000;
    }

    .confirm-dialog {
        background: white;
        border-radius: 12px;
        padding: 1.75rem;
        max-width: 420px;
        width: 90%;
        box-shadow: 0 8px 32px rgba(0,0,0,0.2);
    }
</style>

@code {
    private List<ApplicationUser>? users;
    private Dictionary<string, List<string>> userRoles = new();
    private string? currentUserId;
    private string searchTerm = "";
    private string? message;
    private bool messageSuccess;
    private string? deleteTargetId;
    private string? deleteTargetEmail;

    private IEnumerable<ApplicationUser> FilteredUsers =>
        users!.Where(u => string.IsNullOrEmpty(searchTerm) ||
                         (u.Email?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = UserMgr.Users.ToList();
        userRoles.Clear();
        foreach (var u in users)
        {
            var roles = await UserMgr.GetRolesAsync(u);
            userRoles[u.Id] = roles.ToList();
        }
    }

    private async Task MakeAdmin(string userId)
    {
        var user = await UserMgr.FindByIdAsync(userId);
        if (user == null) return;
        await UserMgr.RemoveFromRoleAsync(user, "User");
        await UserMgr.AddToRoleAsync(user, "Admin");
        await LoadUsersAsync();
        ShowMessage($"{user.Email} mostantól Admin.", true);
    }

    private async Task RemoveAdmin(string userId)
    {
        var user = await UserMgr.FindByIdAsync(userId);
        if (user == null) return;
        await UserMgr.RemoveFromRoleAsync(user, "Admin");
        await UserMgr.AddToRoleAsync(user, "User");
        await LoadUsersAsync();
        ShowMessage($"{user.Email} admin joga elvéve, mostantól User.", true);
    }

    private void ConfirmDelete(string userId, string email)
    {
        deleteTargetId = userId;
        deleteTargetEmail = email;
    }

    private void CancelDelete()
    {
        deleteTargetId = null;
        deleteTargetEmail = null;
    }

    private async Task DeleteUser()
    {
        if (deleteTargetId == null) return;
        var user = await UserMgr.FindByIdAsync(deleteTargetId);
        if (user != null)
        {
            await UserMgr.DeleteAsync(user);
            ShowMessage($"{user.Email} törölve.", true);
        }
        deleteTargetId = null;
        deleteTargetEmail = null;
        await LoadUsersAsync();
    }

    private void ShowMessage(string msg, bool success)
    {
        message = msg;
        messageSuccess = success;
    }
}

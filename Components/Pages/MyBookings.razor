@page "/foglalasaim"
@rendermode InteractiveServer
@using CampRide.Data.Entities
@using CampRide.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject BookingService BookingSvc
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<h2 class="mb-4">Saját foglalásaim</h2>

@if (bookings == null)
{
    <p><em>Betöltés...</em></p>
}
else if (!bookings.Any())
{
    <div class="empty-state">
        <div class="empty-icon">📅</div>
        <h5>Még nincs foglalásod</h5>
        <p class="text-muted">Böngészd az elérhető lakóautóinkat és indulj útnak!</p>
        <a href="/" class="btn btn-success">Lakóautók megtekintése</a>
    </div>
}
else
{
    <div class="bookings-list">
        @foreach (var b in bookings)
        {
            <div class="booking-card @GetCardClass(b.Status)">
                <div class="booking-card-header">
                    <div class="booking-caravan">
                        <span class="booking-icon">🚐</span>
                        <strong>@b.Caravan?.Name</strong>
                    </div>
                    <span class="status-badge @GetStatusBadge(b.Status)">@GetStatusLabel(b.Status)</span>
                </div>

                <div class="booking-card-body">
                    <div class="booking-dates">
                        <div class="date-item">
                            <span class="date-label">Kezdés</span>
                            <span class="date-value">@b.FromDate.ToString("yyyy. MM. dd.")</span>
                        </div>
                        <div class="date-arrow">→</div>
                        <div class="date-item">
                            <span class="date-label">Vége</span>
                            <span class="date-value">@b.ToDate.ToString("yyyy. MM. dd.")</span>
                        </div>
                        <div class="date-item">
                            <span class="date-label">Időtartam</span>
                            <span class="date-value days-count">@((b.ToDate - b.FromDate).Days + 1) nap</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(b.Notes))
                    {
                        <div class="booking-notes">
                            <span class="notes-label">Megjegyzés:</span> @b.Notes
                        </div>
                    }

                    <div class="booking-meta">
                        Foglalás időpontja: @b.CreatedAt.ToString("yyyy. MM. dd. HH:mm")
                    </div>
                </div>

                @if (b.Status == BookingStatus.Pending)
                {
                    <div class="booking-card-footer d-flex justify-content-between align-items-center">
                        <span class="text-muted small">⏳ A foglalás elbírálás alatt áll. Hamarosan értesítünk!</span>
                        @if (confirmCancelId == b.Id)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="small text-danger">Biztosan lemondod?</span>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmCancel(b.Id)">Igen</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="ClearConfirm">Nem</button>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-outline-danger btn-sm"
                                    @onclick="() => AskCancel(b.Id)">
                                Lemondás
                            </button>
                        }
                    </div>
                }
                else if (b.Status == BookingStatus.Approved)
                {
                    <div class="booking-card-footer approved-footer d-flex justify-content-between align-items-center">
                        <span class="small">✅ Foglalásod visszaigazolva! Jó utat!</span>
                        <a href="/api/booking-pdf/@b.Id" target="_blank" class="btn btn-sm btn-outline-success">
                            📄 PDF
                        </a>
                    </div>
                }
                else if (b.Status == BookingStatus.Cancelled)
                {
                    <div class="booking-card-footer cancelled-footer">
                        <span class="small">❌ Ez a foglalás lemondásra került.</span>
                    </div>
                }
            </div>
        }
    </div>
}

<style>
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #555;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
    }

    .bookings-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 700px;
    }

    .booking-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        overflow: hidden;
        border-left: 4px solid #dee2e6;
    }

    .booking-card.card-pending  { border-left-color: #ffc107; }
    .booking-card.card-approved { border-left-color: #198754; }
    .booking-card.card-cancelled { border-left-color: #6c757d; }

    .booking-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem 0.75rem;
        border-bottom: 1px solid #f0f0f0;
    }

    .booking-caravan {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.05rem;
    }

    .booking-icon { font-size: 1.3rem; }

    .status-badge {
        font-size: 0.78rem;
        font-weight: 600;
        padding: 0.3rem 0.75rem;
        border-radius: 20px;
    }

    .badge-pending   { background: #fff3cd; color: #856404; }
    .badge-approved  { background: #d1e7dd; color: #0f5132; }
    .badge-cancelled { background: #e2e3e5; color: #41464b; }

    .booking-card-body {
        padding: 1rem 1.25rem;
    }

    .booking-dates {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
    }

    .date-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .date-label {
        font-size: 0.72rem;
        color: #888;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .date-value {
        font-size: 0.95rem;
        font-weight: 600;
        color: #222;
    }

    .days-count { color: #0d6efd; }

    .date-arrow {
        color: #aaa;
        font-size: 1.2rem;
        margin-top: 0.75rem;
    }

    .booking-notes {
        font-size: 0.85rem;
        color: #555;
        background: #f8f9fa;
        border-radius: 6px;
        padding: 0.4rem 0.75rem;
        margin-bottom: 0.5rem;
    }

    .notes-label { font-weight: 600; color: #333; }

    .booking-meta {
        font-size: 0.78rem;
        color: #aaa;
        margin-top: 0.25rem;
    }

    .booking-card-footer {
        padding: 0.6rem 1.25rem;
        background: #f8f9fa;
        border-top: 1px solid #f0f0f0;
        color: #555;
    }

    .approved-footer  { background: #f0faf4; color: #0f5132; }
    .cancelled-footer { background: #f5f5f5; color: #6c757d; }
</style>

@code {
    private List<BookingEntity>? bookings;
    private string currentUserId = "";
    private int? confirmCancelId = null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        if (!string.IsNullOrEmpty(currentUserId))
        {
            // Vendégként leadott foglalások összekötése a fiókkal (email egyezés alapján)
            var email = authState.User.FindFirst(ClaimTypes.Email)?.Value ?? "";
            if (!string.IsNullOrEmpty(email))
            {
                try { await BookingSvc.LinkGuestBookingsAsync(currentUserId, email); }
                catch { /* nem kritikus, továbblép */ }
            }

            bookings = await BookingSvc.GetUserBookingsAsync(currentUserId);
        }
        else
        {
            bookings = new List<BookingEntity>();
        }
    }

    private void AskCancel(int bookingId)
    {
        confirmCancelId = bookingId;
    }

    private void ClearConfirm()
    {
        confirmCancelId = null;
    }

    private async Task ConfirmCancel(int bookingId)
    {
        confirmCancelId = null;
        if (!string.IsNullOrEmpty(currentUserId))
        {
            try
            {
                await BookingSvc.CancelByUserAsync(bookingId, currentUserId);
                bookings = await BookingSvc.GetUserBookingsAsync(currentUserId);
            }
            catch { /* hiba esetén oldal újratölt */ }
        }
    }

    private string GetStatusBadge(BookingStatus s) => s switch
    {
        BookingStatus.Pending   => "badge-pending",
        BookingStatus.Approved  => "badge-approved",
        BookingStatus.Cancelled => "badge-cancelled",
        _ => ""
    };

    private string GetStatusLabel(BookingStatus s) => s switch
    {
        BookingStatus.Pending   => "⏳ Függőben",
        BookingStatus.Approved  => "✅ Jóváhagyva",
        BookingStatus.Cancelled => "❌ Lemondva",
        _ => s.ToString()
    };

    private string GetCardClass(BookingStatus s) => s switch
    {
        BookingStatus.Pending   => "card-pending",
        BookingStatus.Approved  => "card-approved",
        BookingStatus.Cancelled => "card-cancelled",
        _ => ""
    };
}

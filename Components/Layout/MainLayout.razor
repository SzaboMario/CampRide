@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="/rolunk">Rólunk</a>
            <AuthorizeView>
                <Authorized Context="authState">
                    <span class="user-info">@authState.User.Identity?.Name</span>
                    <form method="post" action="/account/logout" style="display:inline">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-link btn-logout">Kijelentkezés</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="/account/login">Bejelentkezés</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@page "/caravans/{Id:int}"
@rendermode InteractiveServer
@using CampRide.Data.Entities
@using CampRide.Services
@inject CaravanService CaravanService
@inject NavigationManager Navigation

<h1>Galéria</h1>

@if(caravan == null)
{
    <p>Adatok betöltése...</p>
} else
{
    <h3>@caravan.Name</h3>
    <p>@caravan.Description</p>
    <p><strong>Férőhely:</strong> @caravan.Capacity fő</p>

    <hr />

    @if(!caravan.Images.Any())
    {
        <p>Nincsenek feltöltött képek.</p>
    } else
    {
        <div class="gallery-grid">
            @foreach(var image in caravan.Images
                .Where(i => !i.IsDeleted)
                .OrderByDescending(i => i.IsPrimary)
                .ThenBy(i => i.SortOrder))
            {
                <div class="gallery-item">
                    <a href="@GetImagePath(image)" target="_blank">
                        <img src="@GetImagePath(image)" />
                    </a>

                    @if(image.IsPrimary)
                    {
                        <div class="primary-badge">Fő kép</div>
                    }
                </div>
            }
        </div>
    }

    <br />

    <button class="btn btn-success"
            @onclick="StartBooking">
        Foglalás indítása
    </button>

    <button class="btn btn-secondary ms-2" type="button"
            @onclick="BackToList">
        Vissza
    </button>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CaravanEntity? caravan;

    protected override async Task OnParametersSetAsync()
    {
        caravan = await CaravanService.GetByIdAsync(Id);
    }

    private string GetImagePath(CaravanImageEntity image)
    {
        return $"/images/caravans/{image.CaravanId}/{image.FileName}";
    }

    private void StartBooking()
    {
        Navigation.NavigateTo($"/bookings/create/{Id}");
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/caravans");
    }
}
